<Project Sdk="Microsoft.NET.Sdk">

  <!-- The guest half of `winquick desktop`. Built inside the Windows guest by
       `winquick capability install desktop`, which is why this targets the
       framework rather than publishing self-contained: the .NET SDK capability
       volume already carries Microsoft.WindowsDesktop.App, and a self-contained
       publish would need runtime packs the guest cannot download.

       The runtime identifier is deliberately not set here: it follows the guest
       architecture and is passed on the publish command line by
       src/servicing.rs. Baking `win-arm64` in produced an ARM64 apphost on an
       x64 host, which the x64 guest cannot execute. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>wqui</AssemblyName>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CA1416: every call here is Windows-only by construction. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

</Project>
