<Window x:Class="DemoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="MainWindow"
        Title="WinQuick Demo" Height="460" Width="620"
        Background="#FFF3F3F3" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   AutomationProperties.AutomationId="TitleText"
                   Text="WinQuick desktop automation demo"
                   FontSize="20" FontWeight="Bold" Foreground="#FF1F3864" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="NameBox" AutomationProperties.AutomationId="NameBox"
                 AutomationProperties.Name="Name"
                 Height="26" Margin="0,0,0,8" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Department" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  x:Name="DeptCombo" AutomationProperties.AutomationId="DeptCombo"
                  AutomationProperties.Name="Department"
                  Height="26" Margin="0,0,0,8" SelectedIndex="0">
            <ComboBoxItem Content="Engineering"/>
            <ComboBoxItem Content="Design"/>
            <ComboBoxItem Content="Support"/>
        </ComboBox>

        <CheckBox Grid.Row="3" Grid.Column="1"
                  x:Name="AdvancedCheck" AutomationProperties.AutomationId="AdvancedCheck"
                  Content="Advanced mode" Margin="0,4,0,12"/>

        <Button Grid.Row="4" Grid.Column="1"
                AutomationProperties.AutomationId="SaveButton"
                Content="Save" Width="110" Height="30"
                HorizontalAlignment="Left" Click="Save_Click"/>

        <ListBox Grid.Row="5" Grid.ColumnSpan="2"
                 x:Name="HistoryList" AutomationProperties.AutomationId="HistoryList"
                 AutomationProperties.Name="History"
                 Margin="0,14,0,10"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                   x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                   Text="Ready" FontSize="14" Foreground="#FF7F0000"/>
    </Grid>
</Window>
