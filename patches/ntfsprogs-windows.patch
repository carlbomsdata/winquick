+/*
+ * WinQuick: address a partition *inside* a whole-disk image.
+ *
+ * These tools normally want a partition device node -- /dev/disk4s4 and such.
+ * Windows has no equivalent without attaching the image, which needs elevation
+ * and is precisely what endpoint security blocks. Every access below is a seek
+ * or a positioned read/write, so shifting them by a fixed base makes
+ * "image + offset" behave exactly like the partition node does elsewhere.
+ *
+ * The base comes from NTFS_IMAGE_OFFSET, in bytes; unset means zero, so nothing
+ * changes for callers that do not use it.
+ */
+static s64 ntfs_wq_base(void)
+{
+	static s64 base = -1;
+
+	if (base < 0) {
+		const char *e = getenv("NTFS_IMAGE_OFFSET");
+
+		base = (e && *e) ? (s64)strtoll(e, NULL, 10) : 0;
+	}
+	return base;
+}
