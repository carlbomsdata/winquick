 static void whpx_apic_external_nmi(APICCommonState *s)
 {
+    uint32_t lvt = s->lvt[APIC_LVT_LINT1];
+
+    /*
+     * This was an empty function, so an NMI delivered through the APIC was
+     * dropped on the floor. That is every externally injected NMI: x86_nmi()
+     * routes through the APIC whenever one is enabled, so `inject-nmi` on a
+     * WHPX guest did nothing at all.
+     *
+     * LINT1 is the NMI pin. Honour how the guest programmed it, then raise the
+     * interrupt; whpx_vcpu_pre_run() turns that into a pending NMI.
+     */
+    if (!(lvt & APIC_LVT_MASKED) && ((lvt >> 8) & 7) == APIC_DM_NMI) {
+        cpu_interrupt(CPU(s->cpu), CPU_INTERRUPT_NMI);
+    }
 }
 
