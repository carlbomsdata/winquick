+/* The SynIC's pages and timers are opaque blobs rather than registers. */
+static uint32_t whpx_try_get_vp_state(CPUState *cpu,
+                                      WHV_VIRTUAL_PROCESSOR_STATE_TYPE type,
+                                      void *buf, uint32_t len)
+{
+    struct whpx_state *whpx = &whpx_global;
+    UINT32 written = 0;
+    HRESULT hr;
+
+    memset(buf, 0, len);
+    hr = whp_dispatch.WHvGetVirtualProcessorState(
+        whpx->partition, cpu->cpu_index, type, buf, len, &written);
+    return FAILED(hr) ? 0 : written;
+}
+
+static void whpx_try_set_vp_state(CPUState *cpu,
+                                  WHV_VIRTUAL_PROCESSOR_STATE_TYPE type,
+                                  void *buf, uint32_t len)
+{
+    struct whpx_state *whpx = &whpx_global;
+
+    if (!len) {
+        return;
+    }
+    whp_dispatch.WHvSetVirtualProcessorState(
+        whpx->partition, cpu->cpu_index, type, buf, len);
+}
+
