+/* WHPX_DIAG: who cancels a running vCPU, and how often. */
+static uint64_t whpx_cancel_count[8];
+static uint64_t whpx_cancel_total;
+static int whpx_cancel_diag = -1;
+
+static void whpx_cancel_tick(CPUState *cpu)
+{
+    static int64_t next;
+    int64_t now;
+    int i;
+    GString *g;
+
+    if (whpx_cancel_diag < 0) {
+        whpx_cancel_diag = getenv("WHPX_DIAG") != NULL;
+    }
+    if (!whpx_cancel_diag) {
+        return;
+    }
+    whpx_cancel_total++;
+    if (cpu->cpu_index < 8) {
+        whpx_cancel_count[cpu->cpu_index]++;
+    }
+    now = g_get_monotonic_time();
+    if (now < next) {
+        return;
+    }
+    next = now + 1000000;
+    g = g_string_new(NULL);
+    g_string_append_printf(g, "whpx-cancel total=%" PRIu64 " per-vcpu:",
+                           whpx_cancel_total);
+    for (i = 0; i < 8; i++) {
+        if (whpx_cancel_count[i]) {
+            g_string_append_printf(g, " cpu%d=%" PRIu64, i, whpx_cancel_count[i]);
+        }
+    }
+    g_string_append_c(g, '\n');
+    fputs(g->str, stderr);
+    fflush(stderr);
+    g_string_free(g, TRUE);
+}
