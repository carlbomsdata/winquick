+static void whpx_clear_startup_suspend_always(CPUState *cpu)
+{
+    WHV_REGISTER_VALUE reg;
+
+    memset(&reg, 0, sizeof(reg));
+    whpx_get_reg(cpu, WHvRegisterInternalActivityState, &reg);
+    if (reg.InternalActivity.StartupSuspend) {
+        reg.InternalActivity.StartupSuspend = 0;
+        whpx_set_reg(cpu, WHvRegisterInternalActivityState, reg);
+        fprintf(stderr, "whpx-startup late-cleared StartupSuspend on cpu%d\n",
+                cpu->cpu_index);
+        fflush(stderr);
+    }
+}
+
+/* WHPX_DIAG: is a parked AP the whole story? */
+static void whpx_clear_startup_suspend(CPUState *cpu)
+{
+    WHV_REGISTER_VALUE reg;
+
+    if (!getenv("WHPX_CLEAR_STARTUP")) {
+        return;
+    }
+    memset(&reg, 0, sizeof(reg));
+    whpx_get_reg(cpu, WHvRegisterInternalActivityState, &reg);
+    if (reg.InternalActivity.StartupSuspend) {
+        reg.InternalActivity.StartupSuspend = 0;
+        whpx_set_reg(cpu, WHvRegisterInternalActivityState, reg);
+        fprintf(stderr, "whpx-startup cleared StartupSuspend on cpu%d\n",
+                cpu->cpu_index);
+        fflush(stderr);
+    }
+}
