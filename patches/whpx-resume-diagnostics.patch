+/*
+ * WHPX_DIAG: the per-VP state the migration stream does not carry.
+ *
+ * whpx_register_names omits the interrupt/event registers by design, and
+ * nothing saves InternalActivityState at all -- that is where WHP keeps
+ * HaltSuspend, the flag whpx_vcpu_kick_out_of_hlt() clears by hand. If a
+ * restored processor differs from the one that was frozen, it shows up here.
+ */
+static void whpx_diag_lapic_raw(CPUState *cpu, const char *when)
+{
+    uint8_t buf[4096];
+    UINT32 written = 0;
+    HRESULT hr;
+    GString *g;
+    size_t i, last;
+
+    if (!whpx_diag_on()) {
+        return;
+    }
+    memset(buf, 0, sizeof(buf));
+    hr = whp_dispatch.WHvGetVirtualProcessorInterruptControllerState2(
+             whpx_global.partition, cpu->cpu_index, buf, sizeof(buf), &written);
+    if (FAILED(hr)) {
+        fprintf(stderr, "whpx-lapicraw [%s] cpu%d <hr %08lx>\n",
+                when, cpu->cpu_index, hr);
+        fflush(stderr);
+        return;
+    }
+    /* Trim the trailing zeroes so the line stays readable. */
+    last = written;
+    while (last > 0 && buf[last - 1] == 0) {
+        last--;
+    }
+    g = g_string_new(NULL);
+    g_string_append_printf(g, "whpx-lapicraw [%s] cpu%d size=%u used=%zu ",
+                           when, cpu->cpu_index, written, last);
+    for (i = 0; i < last && i < 1200; i++) {
+        g_string_append_printf(g, "%02x", buf[i]);
+    }
+    g_string_append_c(g, '\n');
+    fputs(g->str, stderr);
+    fflush(stderr);
+    g_string_free(g, TRUE);
+}
+
+static void whpx_diag_vp_state(CPUState *cpu, const char *when)
+{
+    static const struct {
+        WHV_REGISTER_NAME name;
+        const char *label;
+    } regs[] = {
+        { WHvRegisterInternalActivityState,          "InternalActivity" },
+        { WHvRegisterPendingInterruption,            "PendingInterruption" },
+        { WHvRegisterInterruptState,                 "InterruptState" },
+        { WHvRegisterPendingEvent,                   "PendingEvent" },
+        { WHvX64RegisterDeliverabilityNotifications, "Deliverability" },
+    };
+    GString *g;
+    size_t i;
+
+    if (!whpx_diag_on()) {
+        return;
+    }
+    g = g_string_new(NULL);
+    g_string_append_printf(g, "whpx-vp [%s] cpu%d halted=%d intreq=0x%x",
+                           when, cpu->cpu_index, cpu->halted,
+                           qatomic_read(&cpu->interrupt_request));
+    for (i = 0; i < ARRAY_SIZE(regs); i++) {
+        WHV_REGISTER_VALUE v;
+        HRESULT hr;
+
+        memset(&v, 0, sizeof(v));
+        hr = whp_dispatch.WHvGetVirtualProcessorRegisters(
+                 whpx_global.partition, cpu->cpu_index,
+                 &regs[i].name, 1, &v);
+        if (FAILED(hr)) {
+            g_string_append_printf(g, " %s=<hr %08lx>", regs[i].label, hr);
+        } else {
+            g_string_append_printf(g, " %s=%016llx:%016llx", regs[i].label,
+                                   (unsigned long long)v.Reg128.High64,
+                                   (unsigned long long)v.Reg128.Low64);
+        }
+    }
+    g_string_append_c(g, '\n');
+    fputs(g->str, stderr);
+    fflush(stderr);
+    g_string_free(g, TRUE);
+}
