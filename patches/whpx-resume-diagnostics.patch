+    }
+    return whpx_msi_diag != 0;
+}
+
+static void whpx_msi_tick(void)
+{
+    static int64_t next;
+    int64_t now = g_get_monotonic_time();
+    GString *g;
+    int i;
+
+    if (now < next) {
+        return;
+    }
+    next = now + 1000000;
+    g = g_string_new(NULL);
+    g_string_append_printf(g,
+        "whpx-msi calls=%" PRIu64 " ok=%" PRIu64 " fail=%" PRIu64
+        " vector0=%" PRIu64 " by vector:",
+        whpx_msi_calls, whpx_msi_ok, whpx_msi_fail, whpx_msi_zero);
+    for (i = 0; i < 256; i++) {
+        if (whpx_msi_vec[i]) {
+            g_string_append_printf(g, " %d=%" PRIu64, i, whpx_msi_vec[i]);
+        }
+    }
+    g_string_append_printf(g, "\nwhpx-apic post_load=%" PRIu64
+                           " reset=%" PRIu64 " per-vcpu put/get:",
+                           whpx_apic_postload_count, whpx_apic_reset_count);
+    for (i = 0; i < 8; i++) {
+        if (whpx_apic_put_count[i] || whpx_apic_get_count[i]) {
+            g_string_append_printf(g, " cpu%d=%" PRIu64 "/%" PRIu64,
+                                   i, whpx_apic_put_count[i], whpx_apic_get_count[i]);
+        }
+    }
+    g_string_append_c(g, '\n');
+    fputs(g->str, stderr);
+    fflush(stderr);
+    g_string_free(g, TRUE);
+}
