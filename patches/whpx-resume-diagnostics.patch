+static int whpx_diag_reason(WHV_RUN_VP_EXIT_REASON r)
+{
+    switch (r) {
+    case WHvRunVpExitReasonNone:                   return 0;
+    case WHvRunVpExitReasonMemoryAccess:           return 1;
+    case WHvRunVpExitReasonX64IoPortAccess:        return 2;
+    case WHvRunVpExitReasonUnrecoverableException: return 3;
+    case WHvRunVpExitReasonInvalidVpRegisterValue: return 4;
+    case WHvRunVpExitReasonUnsupportedFeature:     return 5;
+    case WHvRunVpExitReasonX64InterruptWindow:     return 6;
+    case WHvRunVpExitReasonX64Halt:                return 7;
+    case WHvRunVpExitReasonX64ApicEoi:             return 8;
+    case WHvRunVpExitReasonX64MsrAccess:           return 10;
+    case WHvRunVpExitReasonX64Cpuid:               return 11;
+    case WHvRunVpExitReasonException:              return 12;
+    case WHvRunVpExitReasonX64Rdtsc:               return 13;
+    case WHvRunVpExitReasonX64ApicSmiTrap:         return 14;
+    case WHvRunVpExitReasonHypercall:              return 15;
+    case WHvRunVpExitReasonX64ApicInitSipiTrap:    return 16;
+    case WHvRunVpExitReasonX64ApicWriteTrap:       return 17;
+    case WHvRunVpExitReasonCanceled:               return 18;
+    default:                                       return 19;
+    }
+}
+
+static void whpx_diag_dump(const char *why)
+{
+    GString *g = g_string_new(NULL);
+    int i;
+
+    g_string_append_printf(g,
+        "whpx-diag [%s] exits=%" PRIu64 " prerun=%" PRIu64 " hard=%" PRIu64
+        " inj_event=%" PRIu64 " inj_intr=%" PRIu64 " blocked_notready=%" PRIu64
+        " window=%" PRIu64 " kick_hlt=%" PRIu64 " kicks=%" PRIu64 "\n",
+        why, whpx_diag_st.exits, whpx_diag_st.prerun, whpx_diag_st.hard,
+        whpx_diag_st.inj_event, whpx_diag_st.inj_interruption,
+        whpx_diag_st.blocked_notready, whpx_diag_st.window_reg,
+        whpx_diag_st.kick_hlt, whpx_diag_st.kicks);
+
+    g_string_append(g, "whpx-diag per-vcpu runs/exits/canceled setreg/getreg:");
+    for (i = 0; i < 8; i++) {
+        if (whpx_diag_st.percpu_runs[i] || whpx_diag_st.percpu_setreg[i]) {
+            g_string_append_printf(g,
+                " cpu%d=%" PRIu64 "/%" PRIu64 "/%" PRIu64 " %" PRIu64 "/%" PRIu64,
+                i, whpx_diag_st.percpu_runs[i], whpx_diag_st.percpu_exits[i],
+                whpx_diag_st.percpu_cancel[i], whpx_diag_st.percpu_setreg[i],
+                whpx_diag_st.percpu_getreg[i]);
+        }
+    }
+    g_string_append_c(g, '\n');
+
+    g_string_append(g, "whpx-diag exits by reason:");
+    for (i = 0; i < 20; i++) {
+        if (whpx_diag_st.exit_kind[i]) {
+            g_string_append_printf(g, " %s=%" PRIu64,
+                                   whpx_diag_names[i], whpx_diag_st.exit_kind[i]);
+        }
+    }
+    g_string_append_printf(g,
+        "\nwhpx-diag last gate: irr=%d ready_for_pic=%d IF=%d interruptable=%d"
+        " interruption_pending=%d irqchip_in_kernel=%d interrupt_request=0x%x"
+        " exit_request=%d\n",
+        whpx_diag_st.last_irr, whpx_diag_st.last_ready, whpx_diag_st.last_if,
+        whpx_diag_st.last_interruptable, whpx_diag_st.last_intpending,
+        whpx_diag_st.last_inkernel, whpx_diag_st.last_intreq,
+        whpx_diag_st.last_exitreq);
+    fputs(g->str, stderr);
+    fflush(stderr);
+    g_string_free(g, TRUE);
+}
+
+static void whpx_diag_tick(void)
+{
+    static int64_t next;
+    int64_t now;
+
+    if (!whpx_diag_on()) {
+        return;
+    }
+    now = g_get_monotonic_time();
+    if (now < next) {
+        return;
+    }
+    next = now + 1000000;
+    whpx_diag_dump("tick");
+}
