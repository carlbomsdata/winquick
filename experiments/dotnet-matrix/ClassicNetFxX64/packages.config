<?xml version="1.0" encoding="utf-8"?>
<!--
  The classic restore format. `dotnet msbuild -t:Restore
  -p:RestorePackagesConfig=true` reports "Nothing to do" for it: that restore
  path is .NET Framework-only. What does work is a `nuget.exe` running on the
  Framework the `dotnet-framework` capability provides.

  The project builds whether or not this has been restored — the reference
  below is conditional — so the fixture is useful without a `nuget.exe` and
  proves more with one.
-->
<packages>
  <package id="Newtonsoft.Json" version="13.0.3" targetFramework="net472" />
</packages>
